# UniFlow production environment variables
# Do NOT commit your real .env file or Gmail App Password to GitHub.

UNIFLOW_BASE_URL=https://YOUR-DOMAIN.example

UNIFLOW_DB_HOST=localhost
UNIFLOW_DB_NAME=uniflow_db
UNIFLOW_DB_USER=YOUR_DATABASE_USER
UNIFLOW_DB_PASSWORD=YOUR_DATABASE_PASSWORD

UNIFLOW_SMTP_USERNAME=YOUR_UNIFLOW_GMAIL@example.com
UNIFLOW_SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
